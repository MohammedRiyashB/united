+/**
+ * UNITED public test network.
+ *
+ * This is a public-facing, valueless test network. It inherits Bitcoin Core
+ * testnet4 activation mechanics, but has independent chain identity, genesis,
+ * address encodings and an independently chosen PoW limit. No historical
+ * Bitcoin checkpoints, assume-valid hashes, snapshots or seed nodes are used.
+ */
+class CUnitedTestNetParams : public CTestNet4Params
+{
+public:
+    explicit CUnitedTestNetParams(const TestNetOptions& opts) : CTestNet4Params(opts)
+    {
+        m_chain_type = ChainType::UNITEDTESTNET;
+
+        // UNITED monetary policy and Bitcoin-style 10-minute difficulty schedule.
+        consensus.nSubsidyHalvingInterval = 210000;
+        consensus.BIP34Height = 1;
+        consensus.BIP34Hash = uint256{};
+        consensus.BIP65Height = 1;
+        consensus.BIP66Height = 1;
+        consensus.CSVHeight = 1;
+        consensus.SegwitHeight = 1;
+        consensus.MinBIP9WarningHeight = 0;
+        consensus.powLimit = uint256{"000fffff00000000000000000000000000000000000000000000000000000000"};
+        consensus.nPowTargetTimespan = 14 * 24 * 60 * 60;
+        consensus.nPowTargetSpacing = 10 * 60;
+        consensus.fPowAllowMinDifficultyBlocks = true;
+        consensus.enforce_BIP94 = true;
+        consensus.fPowNoRetargeting = false;
+
+        // No Bitcoin testnet chainwork, assume-valid point or UTXO snapshots.
+        consensus.nMinimumChainWork = uint256{};
+        consensus.defaultAssumeValid = uint256{};
+        m_assumeutxo_data.clear();
+
+        pchMessageStart[0] = 0xfa;
+        pchMessageStart[1] = 0xb1;
+        pchMessageStart[2] = 0xd0;
+        pchMessageStart[3] = 0x02;
+        nDefaultPort = 29446;
+        nPruneAfterHeight = 1000;
+        m_assumed_blockchain_size = 0;
+        m_assumed_chain_state_size = 0;
+
+        const char* united_testnet_genesis_msg = "UNITED PUBLIC TESTNET GENESIS 2026-11-06";
+        const CScript united_testnet_genesis_script = CScript() << OP_RETURN << "554e49544544205055424c494320544553544e4554"_hex;
+        genesis = CreateGenesisBlock(
+            united_testnet_genesis_msg,
+            united_testnet_genesis_script,
+            1700000001,
+            60,
+            0x1f0fffff,
+            1,
+            50 * COIN);
+        consensus.hashGenesisBlock = genesis.GetHash();
+        assert(consensus.hashGenesisBlock == uint256{"00057ebf90a85fff3a45bd543a266d8ed59bc76ee3aadab4fc216416582686d0"});
+        assert(genesis.hashMerkleRoot == uint256{"d913e5cf8a09ccf5d4382c4a1e78d8e8b62c9bc0538240c05b26e2baa1d35446"});
+
+        // No public DNS seed operators or fixed peers have been commissioned yet.
+        vSeeds.clear();
+        vFixedSeeds.clear();
+
+        base58Prefixes[PUBKEY_ADDRESS] = std::vector<unsigned char>(1, 75);
+        base58Prefixes[SCRIPT_ADDRESS] = std::vector<unsigned char>(1, 76);
+        base58Prefixes[SECRET_KEY] = std::vector<unsigned char>(1, 203);
+        base58Prefixes[EXT_PUBLIC_KEY] = {0x04, 0x55, 0x4e, 0x54};
+        base58Prefixes[EXT_SECRET_KEY] = {0x04, 0x55, 0x4e, 0x55};
+        bech32_hrp = "tunit";
+
+        fDefaultConsistencyChecks = false;
+        m_is_mockable_chain = false;
+        chainTxData = ChainTxData{.nTime = 0, .tx_count = 0, .dTxRate = 0.001};
+        m_headers_sync_params = HeadersSyncParams{
+            .commitment_period = 616,
+            .redownload_buffer_size = 16199,
+        };
+    }
+};
+
