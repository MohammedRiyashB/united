+/**
+ * UNITED public test network. This is a valueless network for public wallet,
+ * mining and P2P integration testing. Its difficulty is easier than mainnet,
+ * permits delayed-block minimum difficulty, but retains periodic retargeting.
+ * It has no bootstrap seeds configured; operators must connect using -addnode
+ * until independent seed infrastructure is deployed and reviewed.
+ */
+class CUnitedTestNetParams : public CChainParams
+{
+public:
+    explicit CUnitedTestNetParams(const TestNetOptions& opts)
+    {
+        m_chain_type = ChainType::UNITEDTESTNET;
+        consensus.signet_blocks = false;
+        consensus.signet_challenge.clear();
+        consensus.nSubsidyHalvingInterval = 210000;
+        consensus.BIP34Height = 1;
+        consensus.BIP34Hash = uint256{};
+        consensus.BIP65Height = 1;
+        consensus.BIP66Height = 1;
+        consensus.CSVHeight = 1;
+        consensus.SegwitHeight = 1;
+        consensus.MinBIP9WarningHeight = 0;
+        consensus.powLimit = uint256{"0000ffff00000000000000000000000000000000000000000000000000000000"};
+        consensus.nPowTargetTimespan = 14 * 24 * 60 * 60;
+        consensus.nPowTargetSpacing = 10 * 60;
+        consensus.fPowAllowMinDifficultyBlocks = true;
+        consensus.enforce_BIP94 = true;
+        consensus.fPowNoRetargeting = false;
+
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].bit = 28;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].nStartTime = Consensus::BIP9Deployment::NEVER_ACTIVE;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].nTimeout = Consensus::BIP9Deployment::NO_TIMEOUT;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].min_activation_height = 0;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].threshold = 1512;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].period = 2016;
+
+        consensus.nMinimumChainWork = uint256{};
+        consensus.defaultAssumeValid = uint256{};
+
+        pchMessageStart[0] = 0x75; // 'u'
+        pchMessageStart[1] = 0x6e; // 'n'
+        pchMessageStart[2] = 0x74; // 't'
+        pchMessageStart[3] = 0x31; // '1'
+        nDefaultPort = 29555;
+        nPruneAfterHeight = 1000;
+        m_assumed_blockchain_size = 0;
+        m_assumed_chain_state_size = 0;
+
+        ApplyDeploymentOptions(opts.dep_opts);
+
+        genesis = CreateGenesisBlock(
+            "UNITED public testnet genesis - valueless coins - 2026",
+            CScript() << "04678afdb0fe5548271967f1a67130b7105cd6a828e03909a67962e0ea1f61deb649f6bc3f4cef38c4f35504e51ec112de5c384df7ba0b8d578a4c702b6bf11d5f"_hex << OP_CHECKSIG,
+            1767225600, 15174, 0x1f00ffff, 1, 50 * COIN);
+        consensus.hashGenesisBlock = genesis.GetHash();
+        assert(consensus.hashGenesisBlock == uint256{"00003b8e20fef32b7abc0c295c9bbce1931bc53f5688aeeb75301b997ba6bd00"});
+        assert(genesis.hashMerkleRoot == uint256{"63ba230a57da664d056cb02ed1dc34bd83a0c774bc1c7421ac6474ad97cf82ff"});
+
+        vFixedSeeds.clear();
+        vSeeds.clear();
+        fDefaultConsistencyChecks = false;
+        m_is_mockable_chain = false;
+        m_assumeutxo_data.clear();
+        chainTxData = ChainTxData{.nTime = 0, .tx_count = 0, .dTxRate = 0};
+
+        base58Prefixes[PUBKEY_ADDRESS] = std::vector<unsigned char>(1, 85);
+        base58Prefixes[SCRIPT_ADDRESS] = std::vector<unsigned char>(1, 86);
+        base58Prefixes[SECRET_KEY] = std::vector<unsigned char>(1, 213);
+        base58Prefixes[EXT_PUBLIC_KEY] = {0x04, 0x55, 0x4e, 0x54};
+        base58Prefixes[EXT_SECRET_KEY] = {0x04, 0x55, 0x4e, 0x56};
+        bech32_hrp = "unt";
+
+        m_headers_sync_params = HeadersSyncParams{
+            .commitment_period = 616,
+            .redownload_buffer_size = 16199,
+        };
+    }
+};
