+/**
+ * UNITED public test network. These parameters define a separate SHA-256d
+ * UTXO network. Testnet coins have no monetary value. No DNS/fixed seeds are
+ * embedded: operators must use explicitly published addnode peers until
+ * independently operated seed infrastructure is provisioned.
+ */
+class CUnitedTestNetParams : public CChainParams
+{
+public:
+    explicit CUnitedTestNetParams(const TestNetOptions& opts)
+    {
+        m_chain_type = ChainType::UNITEDTESTNET;
+        consensus.signet_blocks = false;
+        consensus.signet_challenge.clear();
+        consensus.nSubsidyHalvingInterval = 210000;
+        consensus.BIP34Height = 1;
+        consensus.BIP34Hash = uint256{};
+        consensus.BIP65Height = 1;
+        consensus.BIP66Height = 1;
+        consensus.CSVHeight = 1;
+        consensus.SegwitHeight = 1;
+        consensus.MinBIP9WarningHeight = 0;
+        consensus.powLimit = uint256{"00000fffff000000000000000000000000000000000000000000000000000000"};
+        consensus.nPowTargetTimespan = 14 * 24 * 60 * 60;
+        consensus.nPowTargetSpacing = 10 * 60;
+        consensus.fPowAllowMinDifficultyBlocks = true;
+        consensus.enforce_BIP94 = true;
+        consensus.fPowNoRetargeting = false;
+
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].bit = 28;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].nStartTime = Consensus::BIP9Deployment::NEVER_ACTIVE;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].nTimeout = Consensus::BIP9Deployment::NO_TIMEOUT;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].min_activation_height = 0;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].threshold = 1512;
+        consensus.vDeployments[Consensus::DEPLOYMENT_TESTDUMMY].period = 2016;
+        ApplyDeploymentOptions(opts.dep_opts);
+
+        consensus.nMinimumChainWork = uint256{};
+        consensus.defaultAssumeValid = uint256{};
+
+        pchMessageStart[0] = 0xfa;
+        pchMessageStart[1] = 0xce;
+        pchMessageStart[2] = 0xb5;
+        pchMessageStart[3] = 0x02;
+        nDefaultPort = 39444;
+        nPruneAfterHeight = 1000;
+        m_assumed_blockchain_size = 0;
+        m_assumed_chain_state_size = 0;
+
+        const char* genesis_message = "UNITED public testnet genesis - test coins have no monetary value";
+        const CScript genesis_script = CScript() << "04678afdb0fe5548271967f1a67130b7105cd6a828e03909a67962e0ea1f61deb649f6bc3f4cef38c4f35504e51ec112de5c384df7ba0b8d578a4c702b6bf11d5f"_hex << OP_CHECKSIG;
+        genesis = CreateGenesisBlock(genesis_message, genesis_script, 1735689600, 1129160, 0x1e0fffff, 1, 50 * COIN);
+        consensus.hashGenesisBlock = genesis.GetHash();
+        assert(consensus.hashGenesisBlock == uint256{"00000f7003bea5babbc9b271415f351472e51edd3d34e798214f6734b8d27da9"});
+        assert(genesis.hashMerkleRoot == uint256{"3184f943619d506bdc6af367ba93346790766eaa244fdff3989df0a020975256"});
+
+        vFixedSeeds.clear();
+        vSeeds.clear();
+        fDefaultConsistencyChecks = false;
+        m_is_mockable_chain = false;
+        m_assumeutxo_data.clear();
+        chainTxData = ChainTxData{.nTime = 0, .tx_count = 0, .dTxRate = 0.0};
+
+        base58Prefixes[PUBKEY_ADDRESS] = std::vector<unsigned char>(1, 67);
+        base58Prefixes[SCRIPT_ADDRESS] = std::vector<unsigned char>(1, 68);
+        base58Prefixes[SECRET_KEY] = std::vector<unsigned char>(1, 194);
+        base58Prefixes[EXT_PUBLIC_KEY] = {0x04, 0x55, 0x4e, 0x46};
+        base58Prefixes[EXT_SECRET_KEY] = {0x04, 0x55, 0x4e, 0x47};
+        bech32_hrp = "tunit";
+
+        m_headers_sync_params = HeadersSyncParams{
+            .commitment_period = 275,
+            .redownload_buffer_size = 7017,
+        };
+    }
+};
+
