{
  "rules": {
    ".read": false,
    ".write": false,

    "network": {
      ".read": "auth != null",
      ".write": false
    },

    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online']) && newData.numChildren() === 1",
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
