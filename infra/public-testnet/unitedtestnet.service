[Unit]
Description=UNITED Public Testnet Full Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=united
Group=united
ExecStart=/usr/local/bin/bitcoind -chain=unitedtestnet -datadir=/var/lib/unitedtestnet -conf=/etc/united/unitedtestnet.conf -daemon=0
ExecStop=/usr/local/bin/bitcoin-cli -conf=/etc/united/unitedtestnet.conf -chain=unitedtestnet -datadir=/var/lib/unitedtestnet stop
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/unitedtestnet

[Install]
WantedBy=multi-user.target
